# Copy this file to .env and fill in your values
# Demo mode runs entirely in the browser on fictional data and needs nothing else.
# Set VITE_DEMO_MODE=false only with a real Supabase project: it also needs
# VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY, or the app stays in demo mode.
VITE_DEMO_MODE=true
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_project_id
# Real mode only: the Supabase auth user whose password unlocks the dashboard.
VITE_AUTH_EMAIL=demo@example.com
